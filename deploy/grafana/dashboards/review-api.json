{
  "uid": "review-api",
  "title": "Review API",
  "tags": ["digikala", "reviews"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": true,
  "links": [],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(review_http_requests_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP p95",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(review_http_request_seconds_bucket[1m])))" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx ratio",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(rate(review_http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum(rate(review_http_requests_total[1m])), 1e-9)" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Models loaded",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "review_models_loaded" }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Models on disk",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "review_models_catalog" }],
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Process memory",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes{job=\"review-api\"}" }],
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(review_http_request_seconds_bucket[1m])))" },
        { "refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(review_http_request_seconds_bucket[1m])))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests by route",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{method}} {{path}} {{status}}", "expr": "sum by (method, path, status) (rate(review_http_requests_total[1m]))" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Predictions by model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}} {{mode}}", "expr": "sum by (model, mode) (rate(review_predictions_total[1m]))" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Predicted labels",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{task}} {{label}}", "expr": "sum by (task, label) (rate(review_predictions_total[1m]))" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Inference latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}}", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(review_inference_seconds_bucket[1m])))" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Preprocess, tokenize, and embed p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "preprocess {{pipeline}}", "expr": "histogram_quantile(0.95, sum by (le, pipeline) (rate(review_preprocess_seconds_bucket[1m])))" },
        { "refId": "B", "legendFormat": "tokenize {{tokenizer}}", "expr": "histogram_quantile(0.95, sum by (le, tokenizer) (rate(review_tokenize_seconds_bucket[1m])))" },
        { "refId": "C", "legendFormat": "embed {{model}}", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(review_embed_seconds_bucket[1m])))" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Batch size p95",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{operation}}", "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(review_batch_items_bucket[1m])))" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Model load time",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{model}}", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(review_model_load_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Empty text and model errors",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "empty {{operation}}", "expr": "sum by (operation) (rate(review_empty_text_total[1m]))" },
        { "refId": "B", "legendFormat": "error {{model}} {{reason}}", "expr": "sum by (model, reason) (rate(review_model_errors_total[1m]))" }
      ]
    }
  ]
}
